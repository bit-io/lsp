[package]
-> name        => lsp
-> version     => 0.1.0
-> description => Biblioteka do pisania serwerow LSP (Language Server Protocol) w H#
-> authors     => ["Bit Developers"]
-> license     => MIT
-> lang        => h#

[edition]
-> edition => 2026

[layout]
-> src => src

[build]
-> link => static

[lib]
-> output => hlib

[pack]
-> contents    => [hlib, sources, docs]
-> compression => zstd

[dependencies]
